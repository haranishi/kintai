{
  "test_cmd": [
    "cargo",
    "test",
    "-q",
    "-p",
    "kintai-core",
    "--no-fail-fast"
  ],
  "timeout_sec": 900,
  "mutations": [
    {
      "label": "core: 区間の重なりで、端が接するのも重なりにする",
      "file": "crates/kintai-core/src/interval.rs",
      "find": "self.start < other.end && other.start < self.end",
      "replace": "self.start <= other.end && other.start <= self.end"
    },
    {
      "label": "core: うるう年の400年の規則を壊す",
      "file": "crates/kintai-core/src/calendar.rs",
      "find": "|| year % 400 == 0",
      "replace": "|| year % 400 == 1"
    },
    {
      "label": "core: 月の期間で、起算日当日を前の期間にする（kintai-core の試験だけで流すこと。jp-labor の months_from_periods が止まらなくなる）",
      "file": "crates/kintai-core/src/period.rs",
      "find": "if date.day() >= start_day.get() {",
      "replace": "if date.day() > start_day.get() {"
    },
    {
      "label": "core: 1970-01-01 の曜日を金曜にする",
      "file": "crates/kintai-core/src/weekday.rs",
      "find": "0 => Weekday::Thursday,",
      "replace": "0 => Weekday::Friday,"
    },
    {
      "label": "core: 0:00 での分割を2日おきにする",
      "file": "crates/kintai-core/src/interval.rs",
      "find": "let next_midnight = (cursor.div_euclid(MINUTES_PER_DAY) + 1) * MINUTES_PER_DAY;",
      "replace": "let next_midnight = (cursor.div_euclid(MINUTES_PER_DAY) + 2) * MINUTES_PER_DAY;"
    },
    {
      "label": "core: 24:00 を Hour24 として拒否しない",
      "file": "crates/kintai-core/src/instant.rs",
      "find": "if hour == 24 && minute == 0 {\n            return Err(CoreError::Hour24);\n        }\n        if hour > 23 || minute > 59 {",
      "replace": "if hour > 24 || minute > 59 {"
    },
    {
      "label": "core: 入力の日付の範囲（2000〜2099年）を検査しない",
      "file": "crates/kintai-core/src/date.rs",
      "find": "if date.is_input_range() {",
      "replace": "if true || date.is_input_range() {"
    },
    {
      "label": "core: うるう年の100年の規則を外す",
      "file": "crates/kintai-core/src/calendar.rs",
      "find": "(year % 4 == 0 && year % 100 != 0)",
      "replace": "(year % 4 == 0)"
    },
    {
      "label": "core: うるう年の2月を28日にする",
      "file": "crates/kintai-core/src/calendar.rs",
      "find": "                Some(29)\n",
      "replace": "                Some(28)\n"
    },
    {
      "label": "core: 11月を31日にする",
      "file": "crates/kintai-core/src/calendar.rs",
      "find": "        1 | 3 | 5 | 7 | 8 | 10 | 12 => Some(31),\n        4 | 6 | 9 | 11 => Some(30),",
      "replace": "        1 | 3 | 5 | 7 | 8 | 10 | 11 | 12 => Some(31),\n        4 | 6 | 9 => Some(30),"
    },
    {
      "label": "core: 年月日から日数への式で、日を1つずらす",
      "file": "crates/kintai-core/src/calendar.rs",
      "find": "let day_of_year = (153 * shifted_month + 2) / 5 + day - 1;",
      "replace": "let day_of_year = (153 * shifted_month + 2) / 5 + day;"
    },
    {
      "label": "core: 日数から年月日への式で、日を1つずらす",
      "file": "crates/kintai-core/src/calendar.rs",
      "find": "let day = day_of_year - (153 * shifted_month + 2) / 5 + 1;",
      "replace": "let day = day_of_year - (153 * shifted_month + 2) / 5 + 2;"
    },
    {
      "label": "core: 月末の日を暦にない日にする",
      "file": "crates/kintai-core/src/date.rs",
      "find": "if day == 0 || day > last {",
      "replace": "if day == 0 || day >= last {"
    },
    {
      "label": "core: 型の最後の日（2200-12-31）を範囲外にする",
      "file": "crates/kintai-core/src/date.rs",
      "find": "if (MIN_DAY_NUMBER..=MAX_DAY_NUMBER).contains(&days) {",
      "replace": "if (MIN_DAY_NUMBER..MAX_DAY_NUMBER).contains(&days) {"
    },
    {
      "label": "core: 型の最初の日（1900-01-01）を範囲外にする",
      "file": "crates/kintai-core/src/date.rs",
      "find": "const MIN_DAY_NUMBER: i64 = -25_567;",
      "replace": "const MIN_DAY_NUMBER: i64 = -25_566;"
    },
    {
      "label": "core: 入力の最初の日（2000-01-01）を範囲外にする",
      "file": "crates/kintai-core/src/date.rs",
      "find": "const INPUT_MIN_DAY_NUMBER: i64 = 10_957;",
      "replace": "const INPUT_MIN_DAY_NUMBER: i64 = 10_958;"
    },
    {
      "label": "core: 入力の最後の日（2099-12-31）を範囲外にする",
      "file": "crates/kintai-core/src/date.rs",
      "find": "INPUT_MIN_DAY_NUMBER <= self.days && self.days <= INPUT_MAX_DAY_NUMBER",
      "replace": "INPUT_MIN_DAY_NUMBER <= self.days && self.days < INPUT_MAX_DAY_NUMBER"
    },
    {
      "label": "core: 日の加算を1日多くする",
      "file": "crates/kintai-core/src/date.rs",
      "find": "let target = self.days.checked_add(days).ok_or(CoreError::OutOfRange)?;",
      "replace": "let target = self.days.checked_add(days + 1).ok_or(CoreError::OutOfRange)?;"
    },
    {
      "label": "core: 日付の差を1日多くする",
      "file": "crates/kintai-core/src/date.rs",
      "find": "        self.days - earlier.days\n",
      "replace": "        self.days - earlier.days + 1\n"
    },
    {
      "label": "core: 日付の区切りに - 以外を許す",
      "file": "crates/kintai-core/src/date.rs",
      "find": "let [y1, y2, y3, y4, b'-', m1, m2, b'-', d1, d2] = bytes else {",
      "replace": "let [y1, y2, y3, y4, _, m1, m2, _, d1, d2] = bytes else {"
    },
    {
      "label": "core: 60分を許す",
      "file": "crates/kintai-core/src/instant.rs",
      "find": "if hour > 23 || minute > 59 {",
      "replace": "if hour > 23 || minute > 60 {"
    },
    {
      "label": "core: その日の1440分目を許す",
      "file": "crates/kintai-core/src/instant.rs",
      "find": "if minute >= MINUTES_PER_DAY {",
      "replace": "if minute > MINUTES_PER_DAY {"
    },
    {
      "label": "core: 時点の型の最後の分を範囲外にする",
      "file": "crates/kintai-core/src/instant.rs",
      "find": "if (Instant::MIN.minutes..=Instant::MAX.minutes).contains(&minutes) {",
      "replace": "if (Instant::MIN.minutes..Instant::MAX.minutes).contains(&minutes) {"
    },
    {
      "label": "core: 入力の最後の時点を 2100-01-01T00:00 にする",
      "file": "crates/kintai-core/src/instant.rs",
      "find": "minutes: Date::INPUT_MAX.day_number() * MINUTES_PER_DAY + MINUTES_PER_DAY - 1,",
      "replace": "minutes: Date::INPUT_MAX.day_number() * MINUTES_PER_DAY + MINUTES_PER_DAY,"
    },
    {
      "label": "core: 時点の区切りに空白を許さない",
      "file": "crates/kintai-core/src/instant.rs",
      "find": "if separator != b'T' && separator != b' ' {",
      "replace": "if separator != b'T' {"
    },
    {
      "label": "core: 長さ0の区間を許す",
      "file": "crates/kintai-core/src/interval.rs",
      "find": "        if start < end {\n            Ok(Interval { start, end })",
      "replace": "        if start <= end {\n            Ok(Interval { start, end })"
    },
    {
      "label": "core: 区間の終わりの時点を区間に含める",
      "file": "crates/kintai-core/src/interval.rs",
      "find": "self.start <= instant && instant < self.end",
      "replace": "self.start <= instant && instant <= self.end"
    },
    {
      "label": "core: 端が接するだけの区間の交差を返す",
      "file": "crates/kintai-core/src/interval.rs",
      "find": "(start < end).then_some(Interval { start, end })",
      "replace": "(start <= end).then_some(Interval { start, end })"
    },
    {
      "label": "core: 週の起算日を1日前にする",
      "file": "crates/kintai-core/src/period.rs",
      "find": "first_day_number: date.day_number() - offset,",
      "replace": "first_day_number: date.day_number() - offset - 1,"
    },
    {
      "label": "core: 週の起算日からの日数を1つずらす",
      "file": "crates/kintai-core/src/weekday.rs",
      "find": "(self.index_from_monday() + 7 - start.index_from_monday()) % 7",
      "replace": "(self.index_from_monday() + 8 - start.index_from_monday()) % 7"
    },
    {
      "label": "core: 週に8日目を含める",
      "file": "crates/kintai-core/src/period.rs",
      "find": "self.first_day_number <= day && day < self.first_day_number + 7",
      "replace": "self.first_day_number <= day && day <= self.first_day_number + 7"
    },
    {
      "label": "core: 月の起算日に29日を許す",
      "file": "crates/kintai-core/src/period.rs",
      "find": "if (1..=28).contains(&day) {",
      "replace": "if (1..=29).contains(&day) {"
    },
    {
      "label": "core: 1月の起算日前の日の期間を、前の年でなく同じ年の12月にする",
      "file": "crates/kintai-core/src/period.rs",
      "find": "            (date.year() - 1, 12)",
      "replace": "            (date.year(), 12)"
    },
    {
      "label": "core: 12月の期間の次の初日を、翌年の2月にする",
      "file": "crates/kintai-core/src/period.rs",
      "find": "            (i64::from(self.year) + 1, 1)",
      "replace": "            (i64::from(self.year) + 1, 2)"
    },
    {
      "label": "core: 月の期間に初日を含めない",
      "file": "crates/kintai-core/src/period.rs",
      "find": "self.first_day_number() <= day && day < self.next_first_day_number()",
      "replace": "self.first_day_number() < day && day < self.next_first_day_number()"
    },
    {
      "label": "core: 月の期間の初日を起算日の翌日にする",
      "file": "crates/kintai-core/src/period.rs",
      "find": "            i64::from(self.month),\n            i64::from(self.start_day.get()),\n        )",
      "replace": "            i64::from(self.month),\n            i64::from(self.start_day.get()) + 1,\n        )"
    },
    {
      "label": "core: 月の期間に次の期間の初日を含める",
      "file": "crates/kintai-core/src/period.rs",
      "find": "self.first_day_number() <= day && day < self.next_first_day_number()",
      "replace": "self.first_day_number() <= day && day <= self.next_first_day_number()"
    }
  ]
}
