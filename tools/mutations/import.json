{
  "test_cmd": [
    "cargo",
    "test",
    "-q",
    "-p",
    "kintai-import",
    "--no-fail-fast"
  ],
  "timeout_sec": 900,
  "mutations": [
    {
      "label": "取込: 4096バイトちょうどの行を拒否する",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "if line.len() > MAX_LINE_BYTES {",
      "replace": "if line.len() >= MAX_LINE_BYTES {"
    },
    {
      "label": "取込: 10万1人目を受け付ける",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "if self.known.len() >= MAX_EMPLOYEES {",
      "replace": "if self.known.len() > MAX_EMPLOYEES {"
    },
    {
      "label": "取込: 256MiB ちょうどのファイルを拒否する",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "if len > MAX_FILE_BYTES {",
      "replace": "if len >= MAX_FILE_BYTES {"
    },
    {
      "label": "取込: total_minutes の 44640 を拒否する",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "(0..=MAX_MONTH_MINUTES).contains(&value)",
      "replace": "(0..MAX_MONTH_MINUTES).contains(&value)"
    },
    {
      "label": "取込: BOM を取り除かない",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "const UTF8_BOM: &[u8] = b\"\\xEF\\xBB\\xBF\";",
      "replace": "const UTF8_BOM: &[u8] = b\"\\xEF\\xBB\\xBE\";"
    },
    {
      "label": "取込: 途中の空の行を許す",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "if let Some(blank) = first_blank {",
      "replace": "if let Some(blank) = first_blank.filter(|_| false) {"
    },
    {
      "label": "取込: 改行でない CR を許す",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "if line.contains('\\r') {",
      "replace": "if line.contains('\\u{0}') {"
    },
    {
      "label": "取込: 値の足りない行を許す",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "if fields.len() != N {",
      "replace": "if fields.len() > N {"
    },
    {
      "label": "取込: 囲まない値の中の引用符を許す",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "if field.contains('\"') {",
      "replace": "if field.contains('\\u{0}') {"
    },
    {
      "label": "取込: 範囲外の日付を書式の誤りにする",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "if error == CoreError::OutOfRange {",
      "replace": "if error == CoreError::InvalidDate {"
    },
    {
      "label": "取込: BOM がないとき Shift_JIS に切り替えない",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "Err(error) if has_bom =>",
      "replace": "Err(error) if !has_bom =>"
    },
    {
      "label": "取込: BOM のない UTF-8 でないファイルを Shift_JIS でなく UTF-8 で読む",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "        Err(_) => SHIFT_JIS\n",
      "replace": "        Err(_) => encoding_rs::UTF_8\n"
    },
    {
      "label": "取込: 文字コードの誤りの行番号を1つずらす",
      "file": "crates/kintai-import/src/lib.rs",
      "find": ".count()).unwrap_or(u64::MAX);",
      "replace": ".count() + 1).unwrap_or(u64::MAX);"
    },
    {
      "label": "取込: BOM を見つけても取り除かない",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "Some(rest) => (rest, true),",
      "replace": "Some(_) => (bytes, true),"
    },
    {
      "label": "取込: 行の長さに CRLF の CR を含める",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "let line = line.strip_suffix(b\"\\r\").unwrap_or(line);",
      "replace": "let line = line.strip_suffix(b\"\\r\\r\").unwrap_or(line);"
    },
    {
      "label": "取込: 見出しの列名の大文字・小文字を区別しない",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "let Some(column) = columns.iter().position(|name| name == field) else {",
      "replace": "let Some(column) = columns.iter().position(|name| name.eq_ignore_ascii_case(field)) else {"
    },
    {
      "label": "取込: 見出しの重なる列名を拒否しない",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "            Some(true) => {\n                return Err(with_header(ImportError::line(\n                    ImportErrorKind::DuplicateColumn { position },\n                    number,\n                )));\n            }",
      "replace": "            Some(true) => {}"
    },
    {
      "label": "取込: 見出しの足りない列を拒否しない",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "        if !found {",
      "replace": "        if false && !found {"
    },
    {
      "label": "取込: 見出しの列の位置を0から数える",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "let position = index.saturating_add(1);",
      "replace": "let position = index;"
    },
    {
      "label": "取込: 値の多すぎる行を許す",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "if fields.len() != N {",
      "replace": "if fields.len() < N {"
    },
    {
      "label": "取込: 上限の1バイト先まで読んでしまう",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "        .take(limit)\n",
      "replace": "        .take(limit + 1)\n"
    },
    {
      "label": "取込: 上限を超えたファイルを読めたことにする",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "            Ok(_) => return Err(ImportError::whole(ImportErrorKind::FileTooLarge)),",
      "replace": "            Ok(_) => return Ok(bytes),"
    },
    {
      "label": "取込: 休暇・履歴の日付の書式の誤りを日時の誤りにする",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "time_error(error, ImportErrorKind::InvalidDate),",
      "replace": "time_error(error, ImportErrorKind::InvalidTimestamp),"
    },
    {
      "label": "取込: total_minutes の符号（+）を許す",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "if text.is_empty() || !text.bytes().all(|byte| byte.is_ascii_digit()) {",
      "replace": "if text.is_empty() {"
    },
    {
      "label": "取込: 閉じていない引用符を許す",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "                    None => return Err(ImportErrorKind::Quote),",
      "replace": "                    None => break,"
    },
    {
      "label": "取込: 閉じた引用符の直後の文字を許す",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "                Some(_) => return Err(ImportErrorKind::Quote),\n            }\n        } else {",
      "replace": "                Some(_) => position = position.saturating_add(1),\n            }\n        } else {"
    },
    {
      "label": "取込: 1行目が空でも見出しがないことにしない",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "    if line.is_empty() {\n        return Err(with_header(ImportError::line(",
      "replace": "    if false && line.is_empty() {\n        return Err(with_header(ImportError::line("
    },
    {
      "label": "取込: 打刻の行番号を1つずらす",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "imported.lines.push(line);",
      "replace": "imported.lines.push(line + 1);"
    },
    {
      "label": "取込: 休暇の単位 hours を全日として読む",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "[LeaveUnit::Full, LeaveUnit::Half, LeaveUnit::Hours]",
      "replace": "[LeaveUnit::Full, LeaveUnit::Half, LeaveUnit::Full]"
    },
    {
      "label": "取込: 打刻の種別 break_end を break_start として読む",
      "file": "crates/kintai-import/src/lib.rs",
      "find": "            let kind = PunchKind::from_code(kind).ok_or(ImportError::cell(",
      "replace": "            let kind = PunchKind::from_code(kind).map(|kind| if kind == PunchKind::BreakEnd { PunchKind::BreakStart } else { kind }).ok_or(ImportError::cell("
    }
  ]
}
